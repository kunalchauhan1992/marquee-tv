<?xml version="1.0" encoding="utf-8"?>
<!-- The focus ring sits around the tile, in the 3dp margin outside its card, with corners concentric to the
     card's 10dp: nothing of the card shows outside it. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true"><shape><solid android:color="#00000000" /><stroke android:width="3dp" android:color="#FFFF2D5F" /><corners android:radius="13dp" /></shape></item>
    <item><shape><solid android:color="#00000000" /></shape></item>
</selector>
