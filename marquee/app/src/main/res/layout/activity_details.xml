<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg">

    <ImageView android:id="@+id/backdrop" android:layout_width="700dp" android:layout_height="400dp"
        android:layout_gravity="end|top" android:scaleType="centerCrop" android:importantForAccessibility="no" />
    <View android:layout_width="700dp" android:layout_height="400dp" android:layout_gravity="end|top"
        android:background="@drawable/scrim_left" />
    <View android:layout_width="match_parent" android:layout_height="400dp" android:layout_gravity="top"
        android:background="@drawable/scrim_bottom" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
        android:paddingStart="48dp" android:paddingTop="48dp" android:clipChildren="false" android:clipToPadding="false">
        <TextView android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:maxWidth="560dp" android:maxLines="2" android:ellipsize="end" android:textSize="34sp"
            android:fontFamily="@font/poppins_medium" android:textColor="@color/text" />
        <TextView android:id="@+id/meta" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:textSize="13sp" android:textColor="@color/text_3" />
        <TextView android:id="@+id/genres" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:textSize="13sp" android:textColor="@color/text_2" />
        <TextView android:id="@+id/overview" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:maxWidth="500dp" android:maxLines="4" android:ellipsize="end"
            android:lineSpacingMultiplier="1.15" android:textSize="13sp" android:textColor="@color/text_2" />
        <TextView android:id="@+id/where" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:textSize="12sp" android:fontFamily="@font/poppins_medium"
            android:textColor="@color/accent" />
        <LinearLayout android:id="@+id/buttons" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:orientation="horizontal" android:clipChildren="false"
            android:clipToPadding="false" />
        <TextView android:id="@+id/moreTitle" style="@style/Text.Row" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="26dp" android:layout_marginBottom="8dp"
            android:text="@string/more_like_this" android:visibility="invisible" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/more" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:paddingEnd="48dp" android:paddingTop="6dp" android:paddingBottom="6dp"
            android:clipToPadding="false" android:clipChildren="false" />
    </LinearLayout>
</FrameLayout>
