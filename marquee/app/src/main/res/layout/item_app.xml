<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="158dp" android:layout_height="92dp" android:layout_marginEnd="8dp" android:padding="3dp"
    android:foreground="@drawable/tile_focus" android:focusable="true" android:clickable="true"
    android:stateListAnimator="@animator/lift">
    <FrameLayout android:id="@+id/card" android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="@drawable/tile_bg">
        <ImageView android:id="@+id/appImage" android:layout_width="match_parent" android:layout_height="match_parent"
            android:scaleType="fitXY" android:importantForAccessibility="no" />
        <TextView android:id="@+id/appLabel" android:layout_width="match_parent" android:layout_height="match_parent"
            android:gravity="center" android:padding="6dp" android:textSize="12sp" android:textColor="@color/text"
            android:maxLines="2" android:ellipsize="end" android:visibility="gone" />
    </FrameLayout>
</FrameLayout>
