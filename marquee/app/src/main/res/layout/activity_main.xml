<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg">

    <ImageView android:id="@+id/backdrop" android:layout_width="620dp" android:layout_height="360dp"
        android:layout_gravity="end|top" android:scaleType="centerCrop" android:importantForAccessibility="no" />
    <View android:layout_width="620dp" android:layout_height="360dp" android:layout_gravity="end|top"
        android:background="@drawable/scrim_left" />
    <View android:layout_width="match_parent" android:layout_height="360dp" android:layout_gravity="top"
        android:background="@drawable/scrim_bottom" />

    <!-- Content keeps a fixed left margin; the menu opens over it, so tiles never shift or get cut off. -->
    <LinearLayout android:id="@+id/content" android:layout_width="match_parent" android:layout_height="match_parent"
        android:layout_marginStart="64dp" android:orientation="vertical">

        <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal"
            android:gravity="center_vertical" android:paddingStart="24dp" android:paddingEnd="28dp">
            <TextClock android:id="@+id/clock" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:format12Hour="h:mm a" android:format24Hour="HH:mm"
                android:textSize="16sp" android:fontFamily="@font/poppins_regular" android:textColor="@color/text" />
            <ImageButton android:id="@+id/btnSearch" android:layout_width="36dp" android:layout_height="36dp"
                android:background="@drawable/pill_bg" android:src="@drawable/ic_search" android:scaleType="center"
                android:contentDescription="@string/search" android:focusable="true" />
            <ImageView android:id="@+id/wifi" android:layout_width="20dp" android:layout_height="20dp"
                android:layout_marginStart="16dp" android:src="@drawable/ic_wifi" android:importantForAccessibility="no" />
        </LinearLayout>

        <!-- Tall enough for 3 lines of overview plus the buttons at their focused (scaled) size. -->
        <LinearLayout android:id="@+id/hero" android:layout_width="match_parent" android:layout_height="232dp"
            android:orientation="vertical" android:paddingStart="24dp" android:paddingTop="6dp"
            android:clipChildren="false" android:clipToPadding="false">
            <TextView android:id="@+id/heroBadge" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="12sp" android:fontFamily="@font/poppins_medium" android:textColor="@color/accent" />
            <TextView android:id="@+id/heroTitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:maxWidth="480dp" android:maxLines="1" android:ellipsize="end" android:textSize="30sp"
                android:fontFamily="@font/poppins_medium" android:textColor="@color/text" />
            <TextView android:id="@+id/heroMeta" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="12sp" android:textColor="@color/text_3" />
            <TextView android:id="@+id/heroOverview" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:maxWidth="440dp" android:maxLines="3" android:ellipsize="end"
                android:lineSpacingMultiplier="1.15" android:textSize="12.5sp" android:textColor="@color/text_2" />
            <LinearLayout android:id="@+id/heroButtons" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:paddingStart="2dp" android:orientation="horizontal"
                android:clipChildren="false" android:clipToPadding="false">
                <TextView android:id="@+id/btnWatch" style="@style/Button.Hero" android:text="@string/watch_now"
                    android:drawableStart="@drawable/ic_play" />
                <TextView android:id="@+id/btnTrailer" style="@style/Button.Hero" android:layout_marginStart="10dp"
                    android:text="@string/trailer" />
                <TextView android:id="@+id/btnList" style="@style/Button.Hero" android:layout_marginStart="10dp"
                    android:text="@string/add_to_list" android:drawableStart="@drawable/ic_add" />
            </LinearLayout>
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rows" android:layout_width="match_parent"
            android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:clipChildren="false"
            android:paddingBottom="200dp" android:descendantFocusability="afterDescendants" />
    </LinearLayout>

    <LinearLayout android:id="@+id/rail" android:layout_width="64dp" android:layout_height="match_parent"
        android:layout_gravity="start" android:orientation="vertical" android:paddingTop="72dp"
        android:paddingStart="10dp" android:paddingEnd="10dp" android:background="@color/bg" />
</FrameLayout>
