<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginBottom="6dp"
    android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="11dp"
    android:background="@drawable/rail_item_bg" android:focusable="true" android:clickable="true">
    <ImageView android:id="@+id/railIcon" android:layout_width="22dp" android:layout_height="22dp"
        android:importantForAccessibility="no" />
    <TextView android:id="@+id/railLabel" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="16dp" android:textSize="14sp" android:fontFamily="@font/poppins_medium"
        android:textColor="@color/text" android:maxLines="1" android:visibility="gone" />
</LinearLayout>
