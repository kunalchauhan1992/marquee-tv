<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Explicitly opaque: on some firmware a translucent home lets Live TV keep drawing underneath. -->
    <style name="Theme.Marquee" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowSwipeToDismiss">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:fontFamily">@font/poppins_regular</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:defaultFocusHighlightEnabled">false</item>
    </style>
    <!-- The trailer window: floats over Marquee with the screen behind dimmed. -->
    <style name="Theme.Marquee.Trailer" parent="@android:style/Theme.DeviceDefault.Dialog.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.8</item>
        <item name="android:windowCloseOnTouchOutside">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>
    <style name="Text.Row" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_2</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
    </style>
    <style name="Button.Hero" parent="">
        <item name="android:layout_height">34dp</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:background">@drawable/btn_bg</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:stateListAnimator">@animator/lift</item>
    </style>
</resources>
